{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        "profile": {
          ".validate": "newData.hasChildren(['handle', 'name'])",
          "handle": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,16}$/)"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
          },
          "created": {
            ".validate": "newData.isNumber()"
          },
          "about": {
            ".validate": "newData.isString() && newData.val().length <= 140"
          },
          "$other": {
            ".validate": false
          }
        },
        "rooms": {
          "$code": {
            ".validate": "newData.hasChildren(['at'])",
            "role": {
              ".validate": "newData.val() === 'host' || newData.val() === 'member'"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "maps": {
          "$id": {
            ".validate": "newData.hasChildren(['name', 'rows', 'at'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "author": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "rows": {
              "$i": {
                ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 40"
              }
            },
            "odd": {
              ".validate": "newData.isBoolean()"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "published": {
              ".validate": "newData.isString()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "stats": {
          "$key": {
            ".validate": "newData.isNumber()"
          }
        },
        "games": {
          "$code": {
            ".validate": "newData.hasChildren(['at', 'result'])",
            "at": {
              ".validate": "newData.isNumber()"
            },
            "result": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "role": {
              ".validate": "newData.val() === 'human' || newData.val() === 'alien'"
            },
            "chars": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "map": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "players": {
              ".validate": "newData.isNumber()"
            },
            "escaped": {
              ".validate": "newData.isBoolean()"
            },
            "bots": {
              ".validate": "newData.isBoolean()"
            },
            "kills": {
              ".validate": "newData.isNumber()"
            },
            "turns": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "friends": {
      "$me": {
        ".read": "auth != null && auth.uid === $me",
        "$them": {
          ".read": "auth != null && (auth.uid === $me || auth.uid === $them)",
          ".write": "auth != null && auth.uid === $me && root.child('bans').child(auth.uid).val() !== true && root.child('users').child(auth.uid).child('profile/handle').exists()",
          ".validate": "newData.hasChildren(['handle', 'at'])",
          "handle": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,16}$/)" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "friendReq": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $to || (auth.uid === $from && root.child('bans').child(auth.uid).val() !== true && root.child('users').child(auth.uid).child('profile/handle').exists()))",
          ".validate": "newData.hasChildren(['handle', 'name', 'at'])",
          "handle": { ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{3,16}$/)" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".write": "auth != null && (auth.uid === $to || (auth.uid === $from && root.child('friends').child($from).child($to).exists() && root.child('friends').child($to).child($from).exists() && root.child('bans').child(auth.uid).val() !== true))",
          ".validate": "newData.hasChildren(['code', 'name', 'at'])",
          "code": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{4,8}$/)" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "map": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "at": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && (auth.token.admin === true || root.child('rooms').child($code).child('settings/host').val() === auth.uid) && root.child('bans').child(auth.uid).val() !== true",
        ".validate": "newData.hasChildren(['host', 'map', 'mode', 'n', 'max', 'at'])",
        "host": { ".validate": "newData.val() === auth.uid || auth.token.admin === true" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "map": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "mode": { ".validate": "newData.val() === 'ultimate' || newData.val() === 'basic' || newData.val() === 'advanced' || newData.val() === 'infection'" },
        "n": { ".validate": "newData.isNumber()" },
        "max": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 8" },
        "at": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "roomIndex": {
      ".read": "auth != null && auth.token.admin === true",
      "$code": {
        ".write": "auth != null && (auth.token.admin === true || root.child('rooms').child($code).child('settings/host').val() === auth.uid)",
        ".validate": "newData.hasChildren(['host', 'status', 'at'])",
        "host": { ".validate": "newData.isString()" },
        "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'over'" },
        "map": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "players": { ".validate": "newData.isNumber()" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "at": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "bans": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && auth.token.admin === true && auth.uid !== $uid",
        ".validate": "newData.isBoolean()"
      }
    },
    "handles": {
      ".read": "auth != null",
      "$h": {
        ".write": "auth != null && ((!newData.exists() && (data.val() === auth.uid || auth.token.admin === true)) || (newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)))",
        ".validate": "newData.isString()"
      }
    },
    "pubmaps": {
      ".read": "auth != null",
      ".indexOn": ["at"],
      "$id": {
        ".write": "auth != null && ((root.child('bans').child(auth.uid).val() !== true && (!data.exists() || (data.child('owner').val() === auth.uid && newData.child('hidden').val() === data.child('hidden').val()))) || auth.token.admin === true)",
        ".validate": "newData.hasChildren(['owner', 'name', 'rows', 'at'])",
        "owner": {
          ".validate": "newData.val() === auth.uid || auth.token.admin === true"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "author": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "rows": {
          "$i": {
            ".validate": "$i.matches(/^[0-9]{1,2}$/) && newData.isString() && newData.val().length <= 40"
          }
        },
        "odd": {
          ".validate": "newData.isBoolean()"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "hidden": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "reports": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && ((!data.exists() && root.child('bans').child(auth.uid).val() !== true) || auth.token.admin === true)",
        ".validate": "newData.hasChildren(['kind', 'target', 'by', 'at'])",
        "kind": {
          ".validate": "newData.val() === 'map' || newData.val() === 'user'"
        },
        "target": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "by": {
          ".validate": "newData.val() === auth.uid"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "done": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "gameRecords": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && root.child('bans').child(auth.uid).val() !== true && !data.exists() && $id.matches(/^[A-Za-z0-9_]{6,40}$/)",
        ".validate": "newData.hasChildren(['v', 'at', 'n', 'game'])",
        "v": { ".validate": "newData.isNumber()" },
        "at": { ".validate": "newData.isNumber()" },
        "n": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 8" },
        "build": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "mode": { ".validate": "newData.isString() && newData.val().length <= 12" },
        "game": { ".validate": "newData.isString() && newData.val().length < 600000" },
        "$other": { ".validate": false }
      }
    },
    "bottests": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && auth.token.admin === true && !data.exists()",
        ".validate": "newData.hasChildren(['test', 'rating', 'game', 'at']) && newData.child('rating').isNumber() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && newData.child('game').isString() && newData.child('game').val().length < 3000000 && (!newData.child('notes').exists() || (newData.child('notes').isString() && newData.child('notes').val().length <= 2000))"
      }
    },
    "adminlog": {
      ".read": "auth != null && auth.token.admin === true",
      "$id": {
        ".write": "auth != null && auth.token.admin === true && !data.exists()",
        ".validate": "newData.hasChildren(['action', 'at', 'by']) && newData.child('by').val() === auth.uid"
      }
    },
    "rooms": {
      "$room": {
        ".write": "auth != null && !newData.exists() && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || auth.token.admin === true)",
        "created": {
          ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
          ".write": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/) && !data.exists() && root.child('users').child(auth.uid).child('profile/handle').exists() && root.child('bans').child(auth.uid).val() !== true",
          ".validate": "newData.isNumber()"
        },
        "lease": {
          ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
          ".write": "auth != null && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || (root.child('rooms').child($room).child('players').child(auth.uid).exists() && root.child('bans').child(auth.uid).val() !== true && (!data.exists() || data.child('uid').val() === auth.uid || data.child('at').val() < now - 40000)))",
          ".validate": "newData.hasChildren(['uid', 'at']) && newData.child('uid').val() === auth.uid",
          "uid": {
            ".validate": "newData.isString()"
          },
          "dev": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "at": {
            ".validate": "newData.isNumber()"
          }
        },
        "settings": {
          ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
          ".write": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/) && (!data.exists() || data.child('host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid || auth.token.admin === true)",
          ".validate": "newData.hasChildren(['map', 'mode', 'host', 'status'])",
          "map": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "mode": {
            ".validate": "newData.val() === 'ultimate' || newData.val() === 'basic' || newData.val() === 'advanced' || newData.val() === 'infection'"
          },
          "host": {
            ".validate": "newData.isString() && (newData.val() === auth.uid || data.val() === auth.uid || auth.token.admin === true)"
          },
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'over'"
          },
          "first": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000"
          },
          "customMap": {
            ".validate": "newData.isString() && newData.val().length <= 900"
          },
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "pub": {
            ".validate": "newData.isBoolean()"
          },
          "max": {
            ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 8"
          },
          "fill": {
            ".validate": "newData.val() === '' || newData.val() === 'easy' || newData.val() === 'normal' || newData.val() === 'hard'"
          },
          "order": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            }
          },
          "result": {
            "aliensWin": {
              ".validate": "newData.isBoolean()"
            },
            "reason": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "escaped": {
              "$i": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              }
            },
            "$other": {
              ".validate": false
            }
          },
          "track": {
            ".validate": "newData.val() === 'auto' || newData.val() === 'manual'"
          },
          "autoKick": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
          "$uid": {
            ".write": "auth != null && root.child('bans').child(auth.uid).val() !== true && !root.child('rooms').child($room).child('kicks').child(auth.uid).exists() && (data.exists() || root.child('rooms').child($room).child('settings/status').val() !== 'playing') && (auth.uid === $uid || auth.token.admin === true || ($uid.beginsWith('bot_') && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)))",
            ".validate": "newData.hasChildren(['name', 'ready'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
            },
            "ready": {
              ".validate": "newData.isBoolean()"
            },
            "out": {
              ".validate": "newData.val() === 'killed' || newData.val() === 'escaped' || newData.val() === 'trapped' || newData.val() === 'kicked'"
            },
            "conv": {
              ".validate": "newData.isBoolean()"
            },
            "role": {
              ".validate": "newData.val() === 'human' || newData.val() === 'alien'"
            },
            "char": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "bot": {
              ".validate": "newData.val() === 'easy' || newData.val() === 'normal' || newData.val() === 'hard' || newData.val() === 'nn'"
            },
            "guest": {
              ".validate": "newData.isBoolean()"
            },
            "share": {
              ".validate": "newData.isBoolean()"
            },
            "route": {
              ".validate": "newData.isString() && newData.val().length <= 1500 && root.child('rooms').child($room).child('settings/status').val() === 'over'"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "seats": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['turn', 'at'])",
            "pos": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "path": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "items": { "$i": { ".validate": "newData.isString() && newData.val().length <= 40" } },
            "over": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "char": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "role": { ".validate": "newData.val() === 'human' || newData.val() === 'alien'" },
            "turn": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 40" },
            "at": { ".validate": "newData.isNumber()" },
            "fed": { ".validate": "newData.isBoolean()" },
            "reborn": { ".validate": "newData.isBoolean()" },
            "adr": { ".validate": "newData.isBoolean()" },
            "cat": { ".validate": "newData.isBoolean()" },
            "outSent": { ".validate": "newData.isBoolean()" },
            "revealed": { ".validate": "newData.isBoolean()" },
            "routeSent": { ".validate": "newData.isBoolean()" },
            "phase": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "res": { ".validate": "newData.isString() && newData.val().length <= 1500" },
            "mkN": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "journal": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('bans').child(auth.uid).val() !== true && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['at'])",
            "at": { ".validate": "newData.isNumber()" },
            "notes": { ".validate": "newData.isString() && newData.val().length <= 12000" },
            "annos": { ".validate": "newData.isString() && newData.val().length <= 200000" },
            "sus": { ".validate": "newData.isString() && newData.val().length <= 4000" },
            "shapes": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "$other": { ".validate": false }
          }
        },
        "kicks": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid || auth.token.admin === true)",
            ".write": "auth != null && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid || auth.token.admin === true)",
            ".validate": "newData.isBoolean()"
          }
        },
        "turn": {
          ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
          ".write": "auth != null && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid || (data.child('uid').val() === auth.uid && newData.child('n').val() >= data.child('n').val() && newData.child('n').val() <= data.child('n').val() + 1 && root.child('rooms').child($room).child('players').child(newData.child('uid').val()).exists()))",
          ".validate": "newData.hasChildren(['n', 'idx', 'uid'])",
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 40"
          },
          "idx": {
            ".validate": "newData.isNumber()"
          },
          "uid": {
            ".validate": "newData.isString()"
          },
          "$other": {
            ".validate": false
          }
        },
        "counts": {
          ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
          ".write": "auth != null && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)"
        },
        "hatches": {
          ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
          ".write": "auth != null && !newData.exists() && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid || auth.token.admin === true)",
          "$n": {
            ".write": "auth != null && root.child('bans').child(auth.uid).val() !== true && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
            ".validate": "$n.matches(/^[1-4]$/) && (newData.val() === 0 || newData.val() === 1)"
          }
        },
        "log": {
          ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
          ".write": "auth != null && !newData.exists() && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid || auth.token.admin === true)",
          "$id": {
            ".write": "auth != null && root.child('bans').child(auth.uid).val() !== true && root.child('rooms').child($room).child('players').child(auth.uid).exists() && !data.exists()",
            ".validate": "newData.hasChildren(['id', 'turn', 'who', 'kind', 'text', 'at']) && newData.child('text').val().length <= 80 && newData.child('who').val().length <= 20 && newData.child('kind').val().matches(/^(noise|attack|spot|silence|hatch|info|item|reveal)$/)"
          }
        },
        "attacks": {
          ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
          ".write": "auth != null && !newData.exists() && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)",
          "$id": {
            ".write": "auth != null && root.child('bans').child(auth.uid).val() !== true && root.child('rooms').child($room).child('players').child(auth.uid).exists() && !data.exists() && (newData.child('by').val() === auth.uid || (newData.child('by').val().beginsWith('bot_') && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)))",
            ".validate": "newData.hasChildren(['by', 'sector', 'at'])",
            "replies": {
              "$uid": {
                ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (auth.uid === $uid || ($uid.beginsWith('bot_') && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)))",
                ".validate": "newData.hasChildren(['in'])"
              }
            }
          }
        },
        "spots": {
          ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
          ".write": "auth != null && !newData.exists() && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)",
          "$id": {
            ".write": "auth != null && root.child('bans').child(auth.uid).val() !== true && root.child('rooms').child($room).child('players').child(auth.uid).exists() && !data.exists() && (newData.child('by').val() === auth.uid || (newData.child('by').val().beginsWith('bot_') && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)))",
            ".validate": "newData.hasChildren(['by', 'sector', 'at'])",
            "replies": {
              "$uid": {
                ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (auth.uid === $uid || ($uid.beginsWith('bot_') && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)))",
                ".validate": "newData.hasChildren(['in'])"
              }
            }
          }
        },
        "requests": {
          ".read": "auth != null && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)",
          ".write": "auth != null && !newData.exists() && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)",
          "$id": {
            ".write": "auth != null && root.child('rooms').child($room).child('players').child(auth.uid).exists() && (newData.child('uid').val() === auth.uid || root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid', 'type'])"
          }
        },
        "secret": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)",
            "inbox": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "hostdata": {
          ".read": "auth != null && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)",
          ".write": "auth != null && (root.child('rooms').child($room).child('settings/host').val() === auth.uid || root.child('rooms').child($room).child('lease/uid').val() === auth.uid)"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
