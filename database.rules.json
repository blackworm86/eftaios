{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/)",
        "created": {
          ".write": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/) && !data.exists()",
          ".validate": "newData.isNumber()"
        },
        "settings": {
          ".write": "auth != null && $room.matches(/^[A-Z0-9]{4,8}$/) && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['map', 'mode', 'host', 'status'])",
          "map": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "mode": { ".validate": "newData.val() === 'advanced' || newData.val() === 'basic' || newData.val() === 'infection'" },
          "host": { ".validate": "newData.val() === auth.uid" },
          "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'" },
          "first": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "$other": { ".validate": false }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['name', 'ready'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "ready": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "hatches": {
          ".write": "auth != null",
          "$n": { ".validate": "$n.matches(/^[1-4]$/) && (newData.val() === 0 || newData.val() === 1)" }
        },
        "log": {
          ".write": "auth != null",
          "$id": {
            ".validate": "newData.hasChildren(['id', 'turn', 'who', 'kind', 'text', 'at']) && newData.child('text').val().length <= 80 && newData.child('who').val().length <= 20 && newData.child('kind').val().matches(/^(noise|attack|spot|silence|hatch|info)$/)"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
