{
  "name": "eftaios",
  "private": true,
  "description": "Companion and online port for Escape from the Aliens in Outer Space",
  "scripts": {
    "serve": "node tools/serve.js 8123",
    "test": "node tools/test.js",
    "rules:check": "node tools/rules-check.js",
    "test:rules": "firebase emulators:exec --only database --project eftaios-rules \"node tests/rules/rules.test.js\"",
    "emulators": "firebase emulators:start --only database --project eftaios-rules",
    "cleanup:rooms": "node tools/cleanup-rooms.js",
    "admin": "node tools/admin.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "playwright-core": "^1.64.1"
  }
}
